{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/jaymelo-cuebox",
    "artifacts/mockup-sandbox",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run --workspaces --if-present build",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "dev": "npm run dev --workspace=@workspace/jaymelo-cuebox"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
